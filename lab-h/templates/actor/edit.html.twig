{% extends 'base.html.twig' %}

{% block title %}Edycja aktora | Katalog aktorów{% endblock %}

{% block body %}
    <div class="form-panel">
        <div class="page-heading">
            <h1>Edytuj aktora</h1>
            <p class="text-body-secondary mb-0">Zaktualizuj dane: {{ actor.name }}.</p>
        </div>
        <section class="catalog-panel" aria-label="Edycja danych aktora">
            {{ include('actor/_form.html.twig', {'button_label': 'Zapisz zmiany'}) }}
            <div class="border-top pt-3 mt-2">
                {{ include('actor/_delete_form.html.twig') }}
            </div>
        </section>
    </div>
{% endblock %}
