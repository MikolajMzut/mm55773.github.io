<form method="post" action="{{ path('app_actor_delete', {'id': actor.id}) }}" onsubmit="return confirm('Czy na pewno chcesz usunąć tego aktora?');">
    <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ actor.id) }}">
    <button class="btn btn-outline-danger mt-3">Usuń aktora</button>
</form>
